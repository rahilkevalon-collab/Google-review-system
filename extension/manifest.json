{
  "manifest_version": 3,
  "name": "ReviewCraft Google Review Auto-Filler",
  "version": "1.1.3",
  "description": "Seamlessly auto-pastes AI review text and selects star ratings directly in Google Review modals.",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": ["content-webapp.js"],
      "run_at": "document_start"
    },
    {
      "matches": [
        "*://google.com/*",
        "*://*.google.com/*",
        "*://google.co.in/*",
        "*://*.google.co.in/*",
        "*://google.co.uk/*",
        "*://*.google.co.uk/*",
        "*://google.ca/*",
        "*://*.google.ca/*",
        "*://google.com.au/*",
        "*://*.google.com.au/*",
        "*://google.de/*",
        "*://*.google.de/*",
        "*://google.fr/*",
        "*://*.google.fr/*",
        "*://google.it/*",
        "*://*.google.it/*",
        "*://google.es/*",
        "*://*.google.es/*",
        "*://google.nl/*",
        "*://*.google.nl/*",
        "*://*.goo.gl/*"
      ],
      "js": ["content-google.js"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "ReviewCraft Auto-Filler"
  },
  "icons": {
    "48": "icon48.png",
    "128": "icon128.png"
  }
}
