# Server
PORT=5000
DEBUG=True

# Database
MONGODB_URI=mongodb://localhost:27017/seo_review_generator
DB_NAME=seo_review_generator

# AI Providers (Pluggable: gemini, openai, groq, demo)
# If no key is supplied, system operates in clearly labelled high-quality template demo mode
LLM_PROVIDER=demo
GEMINI_API_KEY=
OPENAI_API_KEY=
GROQ_API_KEY=

# ML Deduplication
SIMILARITY_THRESHOLD=0.72
MAX_GENERATION_RETRIES=4
MAX_BATCH_SIZE=5

# Rate Limiting
RATE_LIMIT_PER_MINUTE=60
COOLDOWN_SECONDS=0

# Google Places API (for Company Location auto-detection)
GOOGLE_PLACES_API_KEY=
