# Server
PORT=5000
DEBUG=True

# Database
MONGODB_URI=mongodb://localhost:27017/seo_review_generator
DB_NAME=seo_review_generator

# AI Provider: Groq API (Primary)
LLM_PROVIDER=groq
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b

# ML Deduplication
SIMILARITY_THRESHOLD=0.72
MAX_GENERATION_RETRIES=4
MAX_BATCH_SIZE=5

# Rate Limiting
RATE_LIMIT_PER_MINUTE=60
COOLDOWN_SECONDS=0

# Google Places API (for Company Location auto-detection)
GOOGLE_PLACES_API_KEY=
